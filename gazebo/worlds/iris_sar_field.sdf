    <model name="tile_n2_4"><static>true</static><pose>4 -2 0.002 0 0 0</pose><link name="l"><visual name="v"><geometry><plane><normal>0 0 1</normal><size>2 2</size></plane></geometry><material><ambient>0.2 0.35 0.15 1</ambient><diffuse>0.2 0.35 0.15 1</diffuse></material></visual></link></model>
