    <!-- ============================================================ -->
    <!-- HOUSE: Multicolored walls for visual features                -->
    <!-- ============================================================ -->
    <model name="house_floor">
      <static>true</static>
      <pose>15 0 0.1 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>10 8 0.2</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>10 8 0.2</size></box></geometry>
          <material><ambient>0.55 0.55 0.5 1</ambient><diffuse>0.55 0.55 0.5 1</diffuse></material>
        </visual>
      </link>
    </model>
    <!-- Back wall - BRICK RED -->
    <model name="house_wall_back">
      <static>true</static>
      <pose>20 0 1.6 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.2 8 3</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.2 8 3</size></box></geometry>
          <material><ambient>0.6 0.3 0.2 1</ambient><diffuse>0.6 0.3 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>
    <!-- Left wall - BLUE GREY -->
    <model name="house_wall_left">
      <static>true</static>
      <pose>15 -4 1.6 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>10 0.2 3</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>10 0.2 3</size></box></geometry>
          <material><ambient>0.4 0.45 0.55 1</ambient><diffuse>0.4 0.45 0.55 1</diffuse></material>
        </visual>
      </link>
    </model>
    <!-- Right wall - YELLOW -->
    <model name="house_wall_right">
      <static>true</static>
      <pose>15 4 1.6 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>10 0.2 3</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>10 0.2 3</size></box></geometry>
          <material><ambient>0.8 0.75 0.4 1</ambient><diffuse>0.8 0.75 0.4 1</diffuse></material>
        </visual>
      </link>
    </model>
    <!-- Front wall left - WHITE -->
    <model name="house_wall_front_left">
      <static>true</static>
      <pose>10 -2.5 1.6 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.2 3 3</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.2 3 3</size></box></geometry>
          <material><ambient>0.9 0.9 0.9 1</ambient><diffuse>0.9 0.9 0.9 1</diffuse></material>
        </visual>
      </link>
    </model>
    <!-- Front wall right - DARK GREEN -->
    <model name="house_wall_front_right">
      <static>true</static>
      <pose>10 2.5 1.6 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.2 3 3</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.2 3 3</size></box></geometry>
          <material><ambient>0.2 0.4 0.2 1</ambient><diffuse>0.2 0.4 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>
    <!-- Roof - DARK BROWN -->
    <model name="house_roof">
      <static>true</static>
      <pose>15 0 3.2 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>11 9 0.15</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>11 9 0.15</size></box></geometry>
          <material><ambient>0.35 0.18 0.1 1</ambient><diffuse>0.35 0.18 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>
    <!-- Window frames on front wall for extra features -->
    <model name="window_frame_1">
      <static>true</static>
      <pose>9.89 -2 2.0 0 0 0</pose>
      <link name="link">
        <visual name="v"><geometry><box><size>0.05 0.8 0.8</size></box></geometry>
        <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material></visual>
      </link>
    </model>
    <model name="window_frame_2">
      <static>true</static>
      <pose>9.89 3 2.0 0 0 0</pose>
      <link name="link">
        <visual name="v"><geometry><box><size>0.05 0.8 0.8</size></box></geometry>
        <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material></visual>
      </link>
    </model>
    <!-- Door frame -->
    <model name="door_frame">
      <static>true</static>
      <pose>10 0 1.2 0 0 0</pose>
      <link name="link">
        <visual name="top"><pose>0 0 0.9 0 0 0</pose><geometry><box><size>0.15 2.1 0.1</size></box></geometry>
        <material><ambient>0.4 0.2 0.1 1</ambient><diffuse>0.4 0.2 0.1 1</diffuse></material></visual>
        <visual name="left"><pose>0 -1 0 0 0 0</pose><geometry><box><size>0.15 0.1 1.9</size></box></geometry>
        <material><ambient>0.4 0.2 0.1 1</ambient><diffuse>0.4 0.2 0.1 1</diffuse></material></visual>
        <visual name="right"><pose>0 1 0 0 0 0</pose><geometry><box><size>0.15 0.1 1.9</size></box></geometry>
        <material><ambient>0.4 0.2 0.1 1</ambient><diffuse>0.4 0.2 0.1 1</diffuse></material></visual>
      </link>
    </model>

    <!-- ============================================================ -->
    <!-- PARKING LOT                                                  -->
    <!-- ============================================================ -->
    <model name="parking_lot">
      <static>true</static>
      <pose>-10 0 0.02 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>12 16 0.04</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>12 16 0.04</size></box></geometry>
        <material><ambient>0.25 0.25 0.25 1</ambient><diffuse>0.25 0.25 0.25 1</diffuse></material></visual>
      </link>
    </model>
    <!-- Parking lines -->
    <model name="pl1"><static>true</static><pose>-10 -6 0.05 0 0 0</pose><link name="l"><visual name="v"><geometry><box><size>5 0.1 0.01</size></box></geometry><material><ambient>0.9 0.9 0.2 1</ambient><diffuse>0.9 0.9 0.2 1</diffuse></material></visual></link></model>
    <model name="pl2"><static>true</static><pose>-10 -3 0.05 0 0 0</pose><link name="l"><visual name="v"><geometry><box><size>5 0.1 0.01</size></box></geometry><material><ambient>0.9 0.9 0.2 1</ambient><diffuse>0.9 0.9 0.2 1</diffuse></material></visual></link></model>
